# Copy to .env and fill real values. NEVER commit real secrets.
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/blog_db"
# Pooled (Supavisor transaction mode, port 6543) for runtime, direct for migrations.
# Supabase dashboard -> Connect -> get both strings.
DIRECT_URL="postgresql://postgres:CHANGE_ME@db.CHANGE_ME.supabase.co:5432/postgres"
# DATABASE_URL=postgresql://postgres.giesthfoofjazsykztmy:[CHANGE_ME]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

POST=3005
# Comma-separated FE origins. No `*` when credentials:true.
ALLOWED_ORIGINS=http://localhost:5000,https://blog-tech.duckdns.org
URL_FE=http://localhost:5000
NODE_ENV=develop

# Auth JWT (each >= 32 random bytes, e.g. `openssl rand -hex 32`).
# Rotate immediately if a previous value was ever committed/exposed.
ACCESS_TOKEN_SECRET=REPLACE_WITH_32B_RANDOM_HEX
ACCESS_TOKEN_SECRET_REFRESH=REPLACE_WITH_32B_RANDOM_HEX
RESET_SECRET=REPLACE_WITH_32B_RANDOM_HEX
# Token claims
JWT_ISSUER=blog-tech
JWT_AUDIENCE=blog-fe
# TTLs (15m access recommended; refresh 7d with rotation)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Google OAuth (rotate GOOGLE_CLIENT_SECRET in Google Console if the old one
# was ever committed to git history)
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET

# Cloudinary (server-side only; never expose SECRET to FE)
CLOUDINARY_NAME=REPLACE_ME
CLOUDINARY_KEY=REPLACE_ME
CLOUDINARY_SECRET=REPLACE_ME


EMAIL_USER=REPLACE_ME
EMAIL_PASS=REPLACE_ME
